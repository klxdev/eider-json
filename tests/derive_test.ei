import std.bytes
import std.io
import json

// Derived codecs (json.encode_record, decode_record, encode_enum, decode_enum) with
// `@[json(...)]`: renames, skips, defaults, flattening, discriminators, unknown members,
// limits and paths in errors. No type here has an impl: the traits are `@[derive]` (eider-lang
// C8.42); `Custom` implements them to replace the derived codecs.

@[json(rename_all = "camelCase")]
type User = {
    @[json(name = "id")] user_id: u64,
    display_name: String,
    email: Option[String],
    tags: List[String],
    @[json(default)] score: i32,
    @[json(skip)] cache: List[u8],
    @[json(flatten)] meta: Meta,
}

type Meta = { created: i64, @[json(name = "by")] author: String }

@[json(tag = "kind", rename_all = "snake_case")]
type Shape =
    | Circle(radius: i64)
    | @[json(name = "box")] Rect(w: i64, h: i64)
    | Empty

@[json(unknown = "ignore")]
type Loose = { a: i32, shapes: List[Shape] }

type Custom = { a: i32 }

impl json.Encode for Custom {
    fn encode(self, inout w: json.Writer) { w.string("custom".bytes()) }
}

type Holds = { c: Custom, n: i32 }

fn out(b: List[u8]) uses io { io.outln(b) }

fn user(src: str) uses io {
    let r: Result[User, json.DecodeError] = json.from_json(src.bytes())
    match r {
        Ok(u) => out(json.to_json(u))
        Err(e) => out(json.decode_error_text(e))
    }
}

fn loose(src: str) uses io {
    let r: Result[Loose, json.DecodeError] = json.from_json(src.bytes())
    match r {
        Ok(u) => out(json.to_json(u))
        Err(e) => out(json.decode_error_text(e))
    }
}

fn main() uses io {
    print("-- encode")
    let mut tags: List[String] = List.new()
    tags.push(String.from("a"))
    tags.push(String.from("b \"q\""))
    let u = User(7, String.from("Ada"), None, tags, 3, List.new(), Meta(1700, String.from("sys")))
    out(json.to_json(u))
    out(json.to_json(Circle(2)))
    out(json.to_json(Rect(3, 4)))
    out(json.to_json(Empty))
    out(json.to_json(Holds(Custom(1), 2)))
    print("-- decode")
    let h: Result[Holds, json.DecodeError] = json.from_json("{{\"c\": {{\"a\": 4}}, \"n\": 2}}".bytes())
    match h {
        Ok(x) => out(json.to_json(x))
        Err(e) => out(json.decode_error_text(e))
    }
    user("{{\"id\": 9, \"displayName\": \"Bob\", \"email\": \"b@x\", \"tags\": [], \"created\": 5, \"by\": \"me\"}}")
    user("{{\"id\": 9, \"displayName\": \"Bob\", \"tags\": [\"x\"], \"score\": -4, \"created\": 5, \"by\": \"me\"}}")
    loose("{{\"a\": 1, \"extra\": true, \"shapes\": [\"empty\", {{\"kind\": \"circle\", \"radius\": 3}}, {{\"kind\": \"box\", \"w\": 1, \"h\": 2}}]}}")
    print("-- errors")
    user("{{\"id\": 9, \"displayName\": \"Bob\", \"tags\": [], \"created\": 5, \"by\": \"me\", \"admin\": true}}")
    user("{{\"id\": 9, \"tags\": [], \"created\": 5, \"by\": \"me\"}}")
    user("{{\"id\": -1, \"displayName\": \"Bob\", \"tags\": [], \"created\": 5, \"by\": \"me\"}}")
    user("{{\"id\": 1, \"displayName\": \"Bob\", \"tags\": [\"x\", 2], \"created\": 5, \"by\": \"me\"}}")
    user("{{\"id\": 1, \"id\": 2}}")
    user("[1]")
    loose("{{\"a\": 1, \"shapes\": [{{\"kind\": \"hexagon\"}}]}}")
    loose("{{\"a\": 1, \"shapes\": [{{\"radius\": 3}}]}}")
    loose("{{\"a\": 1, \"shapes\": [{{\"kind\": \"circle\", \"radius\": 3, \"color\": 1}}]}}")
    loose("{{\"a\": 99999999999, \"shapes\": []}}")
    let mut deep = String.from("")
    for i in 0..100 { deep.push_str("[") }
    let mut lim = json.limits()
    lim.max_depth = 8
    let r: Result[List[i64], json.DecodeError] = json.from_json_with(deep.bytes(), lim)
    match r {
        Ok(_) => print("deep ok?")
        Err(e) => out(json.decode_error_text(e))
    }
    print("-- strings")
    print(json.to_string(Circle(5)))
    let sr: Result[Shape, json.DecodeError] = json.from_string(String.from("{{\"kind\": \"box\", \"w\": 7, \"h\": 8}}"))
    match sr {
        Ok(x) => print(json.to_string(x))
        Err(e) => out(json.decode_error_text(e))
    }
    let sb: Result[List[i64], json.DecodeError] = json.from_string(String.from("[1, x]"))
    match sb {
        Ok(_) => print("bad ok?")
        Err(e) => out(json.decode_error_text(e))
    }
    print("-- part of a parsed document")
    let d = json.parse("{{\"meta\": {{\"created\": 3, \"by\": \"x\"}}}}".bytes()).unwrap()
    let mut rd = json.reader(d, json.field(d, d.root, "meta").unwrap())
    let m: Result[Meta, json.DecodeError] = Meta.decode(inout rd)
    match m {
        Ok(v) => out(json.to_json(v))
        Err(e) => out(json.decode_error_text(e))
    }
    print(json.member_name("user_id", "", "camelCase").len())
    out(json.member_name("displayName", "", "SCREAMING_SNAKE_CASE"))
    out(json.member_name("HTTPServer2", "", "kebab-case"))
}
