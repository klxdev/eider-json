//! json: RFC 8259 JSON. Pure Eider, no capabilities (except `ffi` for literals).
//!
//! A parsed document is an arena (Eider has value semantics, so a tree of owned nodes would be
//! copied on every read): `Doc.nodes` holds small integer-only records, a node is named by its
//! index (`u32` id), arrays and objects keep their children as a contiguous run of ids in
//! `Doc.extra` (objects as key-string id, value id pairs), and string contents and number texts
//! live in `Doc.strs`. Reading a node copies a few integers, never a subtree.
//!
//! Parsing is strict: one value with optional whitespace (space, tab, LF, CR) around it; no
//! trailing commas, comments, leading zeros, `+`, `.5`, `NaN`; control characters must be
//! escaped in strings; the input must be valid UTF-8; `\uXXXX` escapes are decoded to UTF-8 and
//! a surrogate pair to one scalar (an unpaired surrogate is an error); nesting is limited to
//! MAX_DEPTH. Errors carry the byte offset and the 1-based line and column (columns count
//! Unicode scalars) of the offending character.
//!
//! Numbers keep their exact text (`num_text`); an integer literal that fits in i64 is also
//! available as a value (`as_int`). Writing a document prints numbers as their exact text.
//!
//! Documents can also be built (`new_null`, `new_bool`, `new_int`, `new_number`, `new_string`,
//! `new_array`, `new_object`; children before parents) and written (`write`). `quote` writes one
//! JSON string and replaces invalid UTF-8 with U+FFFD, so the output is always valid JSON.
//!
//! Untrusted input is parsed with `parse_with(src, limits())`: at most 8 MiB, depth 64,
//! strings of 1 MiB, 100,000 items per container, and no repeated keys (`parse` keeps its
//! old leniency: no size limits, depth MAX_DEPTH, repeated keys allowed).
//!
//! Typed values: `Encode` and `Decode` turn Eider values into JSON and back (`to_json`,
//! `from_json`, `from_json_with`), implemented here for the integers, bool, String, List,
//! Option and Map[String, T]. A record or enum of yours has both with no impl: the traits'
//! default methods (`@derive`, eider-lang C8.42) go over its fields or variants with comptime
//! reflection (eider-lang docs/site/reference/reflection.md), so `to_json(x)` and
//! `from_json(src)` work on any type whose parts have them. To replace that, write the impl
//! (`impl json.Encode for T`; `encode_record` / `decode_record` and `encode_enum` /
//! `decode_enum` are the defaults' bodies, for an impl that adds to them). They are
//! shaped by the `@json(...)` attribute on the type, its fields and its variants: `name`, `skip`, `default`, `flatten`, `rename_all`, `tag`,
//! `unknown`. Decoding is strict by default: a member no field takes is an error
//! (`@json(unknown = "ignore")` on the type allows them), a missing member is an error unless
//! the field is an Option or `@json(default)`, numbers must fit the field's type, and every
//! error names its place as a JSONPath (`$.lines[2].qty: not a u32 ...`). The decoders read
//! a parsed document (`Doc`) through a `Reader`; a format-neutral data model (eider-lang #100)
//! can sit under the same traits later.

import core.sys
import std.bytes

pub const NULL: u32 = 1
pub const BOOL: u32 = 2
pub const NUMBER: u32 = 3
pub const STRING: u32 = 4
pub const ARRAY: u32 = 5
pub const OBJECT: u32 = 6

/// Containers deeper than this are an error (the parser is recursive).
pub const MAX_DEPTH: u32 = 512

/// `kind` is one of the constants above. BOOL: `a` is 0 or 1. NUMBER: `a` indexes `strs`
/// (the exact text), `b` is 1 when `n` holds its value (an integer literal in i64's range).
/// STRING: `a` indexes `strs`. ARRAY: `a` is the start in `extra`, `b` the element count.
/// OBJECT: `a` is the start in `extra`, `b` the member count (2 * b ids: key, value).
pub type Node = { kind: u32, a: u32, b: u32, n: i64 }

pub type Doc = { nodes: List[Node], extra: List[u32], strs: List[List[u8]], root: u32 }

pub type Error = { msg: List[u8], offset: u64, line: u32, col: u32 }

type P = { src: List[u8], i: usize, depth: u32, doc: Doc, err: List[u8], lim: Limits }

/// What `parse_with` accepts: at most `max_bytes` of input, containers nested `max_depth`
/// deep, strings of `max_string` bytes (decoded), `max_items` elements or members per array
/// or object; `duplicates`: whether an object may repeat a key (RFC 8259 leaves it open;
/// a repeated key is how two parsers come to disagree about one document).
pub type Limits = { max_bytes: u64, max_depth: u32, max_string: u64, max_items: u64, duplicates: bool }

/// The defaults for untrusted input (`from_json`): 8 MiB, depth 64, strings of 1 MiB,
/// 100,000 items per container, no repeated keys.
pub fn limits() -> Limits { Limits(8388608, 64, 1048576, 100000, false) }

/// What `parse` has always accepted: any size, depth MAX_DEPTH, repeated keys (the last wins
/// for `get`).
pub fn lenient() -> Limits { Limits(18446744073709551615, MAX_DEPTH, 18446744073709551615, 18446744073709551615, true) }

// ---- building

pub fn new_doc() -> Doc { Doc(List.new(), List.new(), List.new(), 0) }

fn add(inout d: Doc, k: u32, a: u32, b: u32, n: i64) -> u32 {
    d.nodes.push(Node(k, a, b, n))
    (d.nodes.len() - 1) as u32
}

fn add_str(inout d: Doc, s: List[u8]) -> u32 {
    d.strs.push(s)
    (d.strs.len() - 1) as u32
}

pub fn new_null(inout d: Doc) -> u32 { add(inout d, NULL, 0, 0, 0) }

pub fn new_bool(inout d: Doc, v: bool) -> u32 {
    let a: u32 = if v { 1 } else { 0 }
    add(inout d, BOOL, a, 0, 0)
}

pub fn new_int(inout d: Doc, v: i64) -> u32 {
    let t = add_str(inout d, bytes.from_i64(v))
    add(inout d, NUMBER, t, 1, v)
}

/// A number from its text, which must be a valid JSON number (it is written as is).
pub fn new_number(inout d: Doc, text: List[u8]) -> Option[u32] {
    if !valid_number(text) { return None }
    let v = int_value(text)
    let t = add_str(inout d, text)
    match v {
        Some(x) => Some(add(inout d, NUMBER, t, 1, x))
        None => Some(add(inout d, NUMBER, t, 0, 0))
    }
}

pub fn new_string(inout d: Doc, s: List[u8]) -> u32 {
    let t = add_str(inout d, s)
    add(inout d, STRING, t, 0, 0)
}

pub fn new_array(inout d: Doc, items: List[u32]) -> u32 {
    let start = d.extra.len() as u32
    for x in items { d.extra.push(x) }
    add(inout d, ARRAY, start, items.len() as u32, 0)
}

/// An object from its keys and values (same length; the shorter one decides).
pub fn new_object(inout d: Doc, keys: List[List[u8]], vals: List[u32]) -> u32 {
    let mut ids: List[u32] = List.new()
    let n = if keys.len() < vals.len() { keys.len() } else { vals.len() }
    for i in 0..n { ids.push(new_string(inout d, keys[i])) }
    let start = d.extra.len() as u32
    for i in 0..n {
        d.extra.push(ids[i])
        d.extra.push(vals[i])
    }
    add(inout d, OBJECT, start, n as u32, 0)
}

// ---- reading

pub fn kind(d: Doc, id: u32) -> u32 {
    if (id as usize) >= d.nodes.len() { return 0 }
    d.nodes[id as usize].kind
}

pub fn is_null(d: Doc, id: u32) -> bool { kind(d, id) == NULL }

/// The value of a BOOL node.
pub fn as_bool(d: Doc, id: u32) -> Option[bool] {
    if kind(d, id) != BOOL { return None }
    Some(d.nodes[id as usize].a == 1)
}

/// The value of a NUMBER node written as an integer in i64's range.
pub fn as_int(d: Doc, id: u32) -> Option[i64] {
    if kind(d, id) != NUMBER { return None }
    let n = d.nodes[id as usize]
    if n.b != 1 { return None }
    Some(n.n)
}

/// The exact text of a NUMBER node.
pub fn num_text(d: Doc, id: u32) -> Option[List[u8]] {
    if kind(d, id) != NUMBER { return None }
    Some(d.strs[d.nodes[id as usize].a as usize])
}

/// The contents (UTF-8, escapes decoded) of a STRING node.
pub fn as_str(d: Doc, id: u32) -> Option[List[u8]] {
    if kind(d, id) != STRING { return None }
    Some(d.strs[d.nodes[id as usize].a as usize])
}

/// Elements of an ARRAY, members of an OBJECT; 0 for anything else.
pub fn len(d: Doc, id: u32) -> u32 {
    let k = kind(d, id)
    if k == ARRAY || k == OBJECT { return d.nodes[id as usize].b }
    0
}

/// Element i of an ARRAY.
pub fn at(d: Doc, id: u32, i: u32) -> Option[u32] {
    if kind(d, id) != ARRAY { return None }
    let n = d.nodes[id as usize]
    if i >= n.b { return None }
    Some(d.extra[(n.a + i) as usize])
}

/// The key (a STRING node) of member i of an OBJECT.
pub fn key_at(d: Doc, id: u32, i: u32) -> Option[u32] {
    if kind(d, id) != OBJECT { return None }
    let n = d.nodes[id as usize]
    if i >= n.b { return None }
    Some(d.extra[(n.a + 2 * i) as usize])
}

/// The value of member i of an OBJECT.
pub fn val_at(d: Doc, id: u32, i: u32) -> Option[u32] {
    if kind(d, id) != OBJECT { return None }
    let n = d.nodes[id as usize]
    if i >= n.b { return None }
    Some(d.extra[(n.a + 2 * i + 1) as usize])
}

/// The value of the first member named `key` of an OBJECT.
pub fn get(d: Doc, id: u32, key: List[u8]) -> Option[u32] {
    if kind(d, id) != OBJECT { return None }
    let n = d.nodes[id as usize]
    for i in 0..n.b {
        let k = d.extra[(n.a + 2 * i) as usize]
        if bytes.eq(d.strs[d.nodes[k as usize].a as usize], key) { return Some(d.extra[(n.a + 2 * i + 1) as usize]) }
    }
    None
}

/// `get` with a literal key.
pub fn field(d: Doc, id: u32, key: str) -> Option[u32] { get(d, id, sys.lit(key)) }

/// Follow a path of object keys from `id`.
pub fn path(d: Doc, id: u32, keys: List[List[u8]]) -> Option[u32] {
    let mut cur = id.copy()
    for k in keys {
        match get(d, cur, k) {
            Some(x) => { cur = x }
            None => { return None }
        }
    }
    Some(cur)
}

// ---- parsing

/// Parse one JSON text.
pub fn parse(src: List[u8]) -> Result[Doc, Error] { parse_with(src, lenient()) }

/// Parse one JSON text within `lim`.
pub fn parse_with(src: List[u8], lim: Limits) -> Result[Doc, Error] {
    if src.len() as u64 > lim.max_bytes {
        let mut m = sys.lit("the input is larger than ")
        bytes.append(inout m, bytes.from_u64(lim.max_bytes))
        bytes.append(inout m, sys.lit(" bytes"))
        return Err(Error(m, 0, 1, 1))
    }
    let mut p = P(src, 0, 0, new_doc(), List.new(), lim)
    // a UTF-8 byte order mark is not JSON (RFC 8259 8.1: MUST NOT add one; we may reject it)
    ws(inout p)
    let root = match value(inout p) {
        Some(r) => r
        None => { return Err(error_at(p.src, p.i, p.err)) }
    }
    ws(inout p)
    if p.i < p.src.len() { return Err(error_at(p.src, p.i, sys.lit("unexpected text after the value"))) }
    let mut d = p.doc.copy()
    d.root = root
    Ok(d)
}

/// The position of byte `at` in `src`.
fn error_at(src: List[u8], at: usize, msg: List[u8]) -> Error {
    let mut line: u32 = 1
    let mut col: u32 = 1
    let mut i: usize = 0
    while i < at && i < src.len() {
        let b = src[i]
        if b == 10 {
            line += 1
            col = 1
        } else if b < 128 || b >= 192 {
            col += 1
        }
        i += 1
    }
    Error(msg, at as u64, line, col)
}

/// "msg at line L, column C (byte N)"
pub fn error_text(e: Error) -> List[u8] {
    let mut m = e.msg.copy()
    bytes.append(inout m, sys.lit(" at line "))
    bytes.append(inout m, bytes.from_u64(e.line as u64))
    bytes.append(inout m, sys.lit(", column "))
    bytes.append(inout m, bytes.from_u64(e.col as u64))
    bytes.append(inout m, sys.lit(" (byte "))
    bytes.append(inout m, bytes.from_u64(e.offset))
    m.push(41)
    m
}

fn peek(p: P) -> u8 {
    if p.i < p.src.len() { return p.src[p.i] }
    0
}

fn fail(inout p: P, m: str) -> Option[u32] {
    p.err = sys.lit(m)
    None
}

fn ws(inout p: P) {
    while p.i < p.src.len() {
        let c = p.src[p.i]
        if c == 32 || c == 9 || c == 10 || c == 13 {
            p.i += 1
        } else {
            return
        }
    }
}

fn value(inout p: P) -> Option[u32] {
    if p.i >= p.src.len() { return fail(inout p, "unexpected end of input, expected a value") }
    let c = p.src[p.i]
    if c == 123 { return obj(inout p) }
    if c == 91 { return arr(inout p) }
    if c == 34 {
        let s = str_lit(inout p)?
        return Some(new_string(inout p.doc, s))
    }
    if c == 116 { return word(inout p, "true", BOOL, 1) }
    if c == 102 { return word(inout p, "false", BOOL, 0) }
    if c == 110 { return word(inout p, "null", NULL, 0) }
    if c == 45 || bytes.is_digit(c) { return num(inout p) }
    if c == 93 || c == 125 || c == 44 { return fail(inout p, "expected a value") }
    if c == 239 && p.i == 0 { return fail(inout p, "a byte order mark is not allowed") }
    fail(inout p, "unexpected character, expected a value")
}

fn word(inout p: P, w: str, k: u32, a: u32) -> Option[u32] {
    let t = sys.lit(w)
    for x in t {
        if peek(p) != x {
            return fail(inout p, "invalid literal (expected true, false or null)")
        }
        p.i += 1
    }
    Some(add(inout p.doc, k, a, 0, 0))
}

fn enter(inout p: P) -> bool {
    p.depth += 1
    p.depth <= p.lim.max_depth
}

fn arr(inout p: P) -> Option[u32] {
    if !enter(inout p) { return fail(inout p, "nested too deeply") }
    p.i += 1
    let mut items: List[u32] = List.new()
    ws(inout p)
    if peek(p) == 93 {
        p.i += 1
        p.depth -= 1
        return Some(new_array(inout p.doc, items))
    }
    while true {
        ws(inout p)
        let v = value(inout p)?
        items.push(v)
        if items.len() as u64 > p.lim.max_items { return fail(inout p, "too many elements in an array") }
        ws(inout p)
        let c = peek(p)
        if c == 44 {
            p.i += 1
            ws(inout p)
            if peek(p) == 93 { return fail(inout p, "trailing comma in an array") }
        } else if c == 93 {
            p.i += 1
            break
        } else if p.i >= p.src.len() {
            return fail(inout p, "unexpected end of input in an array (expected `,` or `]`)")
        } else {
            return fail(inout p, "expected `,` or `]` in an array")
        }
    }
    p.depth -= 1
    Some(new_array(inout p.doc, items))
}

fn obj(inout p: P) -> Option[u32] {
    if !enter(inout p) { return fail(inout p, "nested too deeply") }
    p.i += 1
    let mut keys: List[u32] = List.new()
    let mut vals: List[u32] = List.new()
    let mut seen: Map[List[u8], bool] = Map.new()
    ws(inout p)
    if peek(p) == 125 {
        p.i += 1
        p.depth -= 1
        return Some(pairs(inout p.doc, keys, vals))
    }
    while true {
        ws(inout p)
        if p.i >= p.src.len() { return fail(inout p, "unexpected end of input in an object (expected a key)") }
        if peek(p) != 34 { return fail(inout p, "expected a string key in an object") }
        let k = str_lit(inout p)?
        if !p.lim.duplicates {
            if seen.contains(k) { return fail(inout p, "a key repeated in an object") }
            seen.insert(k.copy(), true)
        }
        if keys.len() as u64 >= p.lim.max_items { return fail(inout p, "too many members in an object") }
        keys.push(new_string(inout p.doc, k))
        ws(inout p)
        if peek(p) != 58 {
            if p.i >= p.src.len() { return fail(inout p, "unexpected end of input in an object (expected `:`)") }
            return fail(inout p, "expected `:` after an object key")
        }
        p.i += 1
        ws(inout p)
        let v = value(inout p)?
        vals.push(v)
        ws(inout p)
        let c = peek(p)
        if c == 44 {
            p.i += 1
            ws(inout p)
            if peek(p) == 125 { return fail(inout p, "trailing comma in an object") }
        } else if c == 125 {
            p.i += 1
            break
        } else if p.i >= p.src.len() {
            return fail(inout p, r"unexpected end of input in an object (expected `,` or `}`)")
        } else {
            return fail(inout p, r"expected `,` or `}` in an object")
        }
    }
    p.depth -= 1
    Some(pairs(inout p.doc, keys, vals))
}

fn pairs(inout d: Doc, keys: List[u32], vals: List[u32]) -> u32 {
    let start = d.extra.len() as u32
    for i in 0..keys.len() {
        d.extra.push(keys[i])
        d.extra.push(vals[i])
    }
    add(inout d, OBJECT, start, keys.len() as u32, 0)
}

fn hexval(c: u8) -> i32 {
    if c >= 48 && c <= 57 { return (c - 48) as i32 }
    if c >= 97 && c <= 102 { return (c - 87) as i32 }
    if c >= 65 && c <= 70 { return (c - 55) as i32 }
    -1
}

/// Four hex digits at the cursor (after `\u`); -1 if they aren't.
fn hex4(inout p: P) -> i32 {
    let mut v: i32 = 0
    for k in 0..4 {
        if p.i >= p.src.len() { return -1 }
        let h = hexval(p.src[p.i])
        if h < 0 { return -1 }
        v = v * 16 + h
        p.i += 1
    }
    v
}

/// Append scalar `c` as UTF-8.
pub fn put_utf8(inout out: List[u8], c: u32) {
    if c < 128 {
        out.push(c as u8)
    } else if c < 2048 {
        out.push((192 + c / 64) as u8)
        out.push((128 + c % 64) as u8)
    } else if c < 65536 {
        out.push((224 + c / 4096) as u8)
        out.push((128 + (c / 64) % 64) as u8)
        out.push((128 + c % 64) as u8)
    } else {
        out.push((240 + c / 262144) as u8)
        out.push((128 + (c / 4096) % 64) as u8)
        out.push((128 + (c / 64) % 64) as u8)
        out.push((128 + c % 64) as u8)
    }
}

/// The length of the valid UTF-8 sequence at s[i] (1 to 4), or 0 if it isn't one (overlong
/// forms, surrogates and values above U+10FFFF are invalid).
pub fn utf8_len(s: List[u8], i: usize) -> usize {
    let b = s[i]
    if b < 128 { return 1 }
    let mut n: usize = 0
    let mut lo: u8 = 128
    let mut hi: u8 = 191
    if b >= 194 && b <= 223 {
        n = 2
    } else if b >= 224 && b <= 239 {
        n = 3
        if b == 224 { lo = 160 }
        if b == 237 { hi = 159 }
    } else if b >= 240 && b <= 244 {
        n = 4
        if b == 240 { lo = 144 }
        if b == 244 { hi = 143 }
    } else {
        return 0
    }
    if i + n > s.len() { return 0 }
    let c1 = s[i + 1]
    if c1 < lo || c1 > hi { return 0 }
    let mut k: usize = 2
    while k < n {
        let c = s[i + k]
        if c < 128 || c > 191 { return 0 }
        k += 1
    }
    n
}

/// A string literal at the cursor (the opening quote); returns its decoded contents.
fn str_lit(inout p: P) -> Option[List[u8]] {
    p.i += 1
    let mut out: List[u8] = List.new()
    while true {
        if p.i >= p.src.len() {
            p.err = sys.lit("unterminated string")
            return None
        }
        let c = p.src[p.i]
        if c == 34 {
            p.i += 1
            break
        }
        if c < 32 {
            p.err = sys.lit("control character in a string (must be escaped)")
            return None
        }
        if c == 92 {
            p.i += 1
            if p.i >= p.src.len() {
                p.err = sys.lit("unterminated string")
                return None
            }
            let e = p.src[p.i]
            p.i += 1
            if e == 34 || e == 92 || e == 47 {
                out.push(e)
            } else if e == 98 {
                out.push(8)
            } else if e == 102 {
                out.push(12)
            } else if e == 110 {
                out.push(10)
            } else if e == 114 {
                out.push(13)
            } else if e == 116 {
                out.push(9)
            } else if e == 117 {
                let at = p.i - 2
                let u = hex4(inout p)
                if u < 0 {
                    p.i = at
                    p.err = sys.lit("invalid \\u escape (expected four hex digits)")
                    return None
                }
                if u >= 56320 && u <= 57343 {
                    p.i = at
                    p.err = sys.lit("unpaired low surrogate in a \\u escape")
                    return None
                }
                if u >= 55296 && u <= 56319 {
                    if p.i + 1 < p.src.len() && p.src[p.i] == 92 && p.src[p.i + 1] == 117 {
                        p.i += 2
                        let lo = hex4(inout p)
                        if lo < 56320 || lo > 57343 {
                            p.i = at
                            p.err = sys.lit("high surrogate not followed by a low surrogate")
                            return None
                        }
                        let cp = 65536 + ((u - 55296) as u32) * 1024 + ((lo - 56320) as u32)
                        put_utf8(inout out, cp)
                    } else {
                        p.i = at
                        p.err = sys.lit("high surrogate not followed by a low surrogate")
                        return None
                    }
                } else {
                    put_utf8(inout out, u as u32)
                }
            } else {
                p.i -= 2
                p.err = sys.lit("invalid escape in a string")
                return None
            }
        } else if c < 128 {
            out.push(c)
            p.i += 1
        } else {
            let n = utf8_len(p.src, p.i)
            if n == 0 {
                p.err = sys.lit("invalid UTF-8 in a string")
                return None
            }
            for k in 0..n { out.push(p.src[p.i + (k as usize)]) }
            p.i += n
        }
    }
    if out.len() as u64 > p.lim.max_string {
        p.err = sys.lit("a string longer than the limit")
        return None
    }
    Some(out)
}

/// A number at the cursor: -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?
fn num(inout p: P) -> Option[u32] {
    let start = p.i.copy()
    if peek(p) == 45 { p.i += 1 }
    if !bytes.is_digit(peek(p)) { return fail(inout p, "expected a digit") }
    if peek(p) == 48 {
        p.i += 1
        if bytes.is_digit(peek(p)) { return fail(inout p, "leading zeros are not allowed") }
    } else {
        while bytes.is_digit(peek(p)) { p.i += 1 }
    }
    if peek(p) == 46 {
        p.i += 1
        if !bytes.is_digit(peek(p)) { return fail(inout p, "expected a digit after the decimal point") }
        while bytes.is_digit(peek(p)) { p.i += 1 }
    }
    if peek(p) == 101 || peek(p) == 69 {
        p.i += 1
        if peek(p) == 43 || peek(p) == 45 { p.i += 1 }
        if !bytes.is_digit(peek(p)) { return fail(inout p, "expected a digit in the exponent") }
        while bytes.is_digit(peek(p)) { p.i += 1 }
    }
    let text = bytes.slice(p.src, start, p.i)
    let v = int_value(text)
    let t = add_str(inout p.doc, text)
    match v {
        Some(x) => Some(add(inout p.doc, NUMBER, t, 1, x))
        None => Some(add(inout p.doc, NUMBER, t, 0, 0))
    }
}

/// The whole text is a JSON number.
fn valid_number(text: List[u8]) -> bool {
    if text.len() == 0 { return false }
    let mut p = P(text, 0, 0, new_doc(), List.new(), lenient())
    match num(inout p) {
        Some(_) => p.i == text.len()
        None => false
    }
}

/// The value of an integer literal (digits with an optional `-`) in i64's range.
fn int_value(t: List[u8]) -> Option[i64] {
    let mut i: usize = 0
    let mut neg = false
    if t.len() > 0 && t[0] == 45 {
        neg = true
        i = 1
    }
    if i >= t.len() { return None }
    // magnitude up to 2^63 (for i64's minimum)
    let mut m: u64 = 0
    while i < t.len() {
        let c = t[i]
        if !bytes.is_digit(c) { return None }
        let dg = (c - 48) as u64
        if m > (9223372036854775808 - dg) / 10 { return None }
        m = m * 10 + dg
        i += 1
    }
    if neg {
        if m == 9223372036854775808 { return Some(-9223372036854775807 - 1) }
        return Some(0 - (m as i64))
    }
    if m > 9223372036854775807 { return None }
    Some(m as i64)
}

// ---- writing

fn hex_digit(n: u32) -> u8 {
    if n < 10 { return (48 + n) as u8 }
    (87 + n) as u8
}

/// `s` as a JSON string literal appended to `out`: `"` and `\` escaped, control characters as
/// \b \f \n \r \t or \u00XX, everything else as UTF-8 (invalid UTF-8 becomes U+FFFD).
pub fn quote_into(inout out: List[u8], s: List[u8]) {
    out.push(34)
    let mut i: usize = 0
    while i < s.len() {
        let c = s[i]
        if c == 34 || c == 92 {
            out.push(92)
            out.push(c)
            i += 1
        } else if c >= 32 && c < 128 {
            out.push(c)
            i += 1
        } else if c < 32 {
            out.push(92)
            if c == 8 {
                out.push(98)
            } else if c == 12 {
                out.push(102)
            } else if c == 10 {
                out.push(110)
            } else if c == 13 {
                out.push(114)
            } else if c == 9 {
                out.push(116)
            } else {
                out.push(117)
                out.push(48)
                out.push(48)
                out.push(hex_digit((c / 16) as u32))
                out.push(hex_digit((c % 16) as u32))
            }
            i += 1
        } else {
            let n = utf8_len(s, i)
            if n == 0 {
                put_utf8(inout out, 65533)
                i += 1
            } else {
                for k in 0..n { out.push(s[i + (k as usize)]) }
                i += n
            }
        }
    }
    out.push(34)
}

pub fn quote(s: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    quote_into(inout out, s)
    out
}

/// Node `id` as compact JSON text.
pub fn write(d: Doc, id: u32) -> List[u8] {
    let mut out: List[u8] = List.new()
    write_into(inout out, d, id)
    out
}

pub fn write_into(inout out: List[u8], d: Doc, id: u32) {
    let k = kind(d, id)
    if k == NULL || k == 0 {
        bytes.append(inout out, sys.lit("null"))
        return
    }
    let n = d.nodes[id as usize]
    if k == BOOL {
        let w = if n.a == 1 { sys.lit("true") } else { sys.lit("false") }
        bytes.append(inout out, w)
    } else if k == NUMBER {
        bytes.append(inout out, d.strs[n.a as usize])
    } else if k == STRING {
        quote_into(inout out, d.strs[n.a as usize])
    } else if k == ARRAY {
        out.push(91)
        for i in 0..n.b {
            if i > 0 { out.push(44) }
            write_into(inout out, d, d.extra[(n.a + i) as usize])
        }
        out.push(93)
    } else {
        out.push(123)
        for i in 0..n.b {
            if i > 0 { out.push(44) }
            write_into(inout out, d, d.extra[(n.a + 2 * i) as usize])
            out.push(58)
            write_into(inout out, d, d.extra[(n.a + 2 * i + 1) as usize])
        }
        out.push(125)
    }
}

// ---- typed values: Encode, Decode and the derived codecs

/// How a type, field or variant maps to JSON (eider-lang docs/site/guide/json.md). On a
/// field: `name` (the member's key; default the field's name), `skip` (never written; on
/// decoding its Default), `default` (missing on decoding: its Default instead of an error),
/// `flatten` (a record field whose members are the outer object's). On a variant: `name` (its
/// tag). On a type: `rename_all` (`snake_case`, `camelCase`, `kebab-case` or `SCREAMING_SNAKE_CASE`,
/// for the fields' or the variants' names), `tag` (an enum's discriminator key, default
/// `type`), `unknown` (`deny`, the default, or `ignore`: what decoding does with a member no
/// field takes).
pub attr json { name: str = "", skip: bool = false, default: bool = false, flatten: bool = false, rename_all: str = "", tag: str = "", unknown: str = "" }

/// A value that can be written as JSON. A record or enum of yours has it with no impl (`@derive`:
/// the default `encode` goes over its fields or variants, `@json(...)` applies); write
/// `impl json.Encode for T` to replace that.
@derive
pub trait Encode {
    fn encode(self, inout w: Writer) {
        comptime if is_enum[Self] { encode_enum(self, inout w) } else { encode_record(self, inout w) }
    }
}

/// A value that can be read from JSON: `decode` reads the value `r` is at; `missing` is the
/// value of a record field whose member is absent (Some(None) for an Option, else None: the
/// member is required).
///
/// Like Encode, a record or enum of yours has it with no impl.
@derive
pub trait Decode {
    fn decode(inout r: Reader) -> Result[Self, DecodeError] {
        comptime if is_enum[Self] { decode_enum(inout r) } else { decode_record(inout r) }
    }
    fn missing() -> Option[Self] { None }
}

/// Why decoding failed, and where: `path` is a JSONPath to the value (`$.items[3].qty`).
pub type DecodeError = { path: List[u8], msg: List[u8] }

/// "<path>: <msg>"
pub fn decode_error_text(e: DecodeError) -> List[u8] {
    let mut m = e.path.copy()
    bytes.append(inout m, sys.lit(": "))
    bytes.append(inout m, e.msg)
    m
}

/// `x` as compact JSON text.
pub fn to_json[T: Encode](x: T) -> List[u8] {
    let mut w = writer()
    x.encode(inout w)
    w.out
}

/// The value of type T in the JSON text `src`, parsed within `limits()` (repeated keys are
/// errors).
pub fn from_json[T: Decode](src: List[u8]) -> Result[T, DecodeError] { from_json_with(src, limits()) }

pub fn from_json_with[T: Decode](src: List[u8], lim: Limits) -> Result[T, DecodeError] {
    let d = match parse_with(src, lim) {
        Ok(x) => x
        Err(e) => { return Err(DecodeError(sys.lit("$"), error_text(e))) }
    }
    let root = d.root
    let mut r = Reader(d, root, List.new(), List.new(), 0)
    T.decode(inout r)
}

// ---- writing

/// JSON text being written: `open` holds, per open array or object, whether it has a value
/// yet; `keyed` that a member's key was just written.
pub type Writer = { out: List[u8], open: List[bool], keyed: bool }

pub fn writer() -> Writer { Writer(List.new(), List.new(), false) }

impl Writer {
    /// Before a value: the comma that separates it from the one before.
    fn sep(inout self) {
        if self.keyed {
            self.keyed = false
            return
        }
        let n = self.open.len()
        if n == 0 { return }
        if self.open[n - 1] { self.out.push(44) }
        self.open[n - 1] = true
    }

    fn null_value(inout self) {
        self.sep()
        bytes.append(inout self.out, sys.lit("null"))
    }

    fn bool(inout self, b: bool) {
        self.sep()
        if b { bytes.append(inout self.out, sys.lit("true")) } else { bytes.append(inout self.out, sys.lit("false")) }
    }

    fn int(inout self, v: i64) {
        self.sep()
        bytes.append(inout self.out, bytes.from_i64(v))
    }

    fn uint(inout self, v: u64) {
        self.sep()
        bytes.append(inout self.out, bytes.from_u64(v))
    }

    fn string(inout self, s: List[u8]) {
        self.sep()
        quote_into(inout self.out, s)
    }

    fn begin_array(inout self) {
        self.sep()
        self.out.push(91)
        self.open.push(false)
    }

    fn end_array(inout self) {
        self.open.pop()
        self.out.push(93)
    }

    fn begin_object(inout self) {
        self.sep()
        self.out.push(123)
        self.open.push(false)
    }

    fn end_object(inout self) {
        self.open.pop()
        self.out.push(125)
    }

    /// A member's key; its value follows.
    fn key(inout self, k: List[u8]) {
        self.sep()
        quote_into(inout self.out, k)
        self.out.push(58)
        self.keyed = true
    }

    /// The members of an object written as `{...}` by another Writer, as members of the
    /// object being written (`flatten`).
    fn members(inout self, obj: List[u8]) {
        if obj.len() <= 2 { return }
        self.sep()
        bytes.append(inout self.out, bytes.slice(obj, 1, obj.len() - 1))
    }
}

impl Encode for i64 {
    fn encode(self, inout w: Writer) { w.int(self) }
}

impl Encode for i32 {
    fn encode(self, inout w: Writer) { w.int(self as i64) }
}

impl Encode for u8 {
    fn encode(self, inout w: Writer) { w.uint(self as u64) }
}

impl Encode for u32 {
    fn encode(self, inout w: Writer) { w.uint(self as u64) }
}

impl Encode for u64 {
    fn encode(self, inout w: Writer) { w.uint(self) }
}

impl Encode for usize {
    fn encode(self, inout w: Writer) { w.uint(self as u64) }
}

impl Encode for bool {
    fn encode(self, inout w: Writer) { w.bool(self) }
}

impl Encode for String {
    fn encode(self, inout w: Writer) { w.string(self.bytes()) }
}

impl Encode for str {
    fn encode(self, inout w: Writer) { w.string(self.bytes()) }
}

impl[T: Encode] Encode for List[T] {
    fn encode(self, inout w: Writer) {
        w.begin_array()
        for x in self { x.encode(inout w) }
        w.end_array()
    }
}

impl[T: Encode] Encode for Option[T] {
    fn encode(self, inout w: Writer) {
        match self {
            Some(x) => x.encode(inout w)
            None => w.null_value()
        }
    }
}

impl[T: Encode] Encode for Map[String, T] {
    fn encode(self, inout w: Writer) {
        // in key order, so equal Maps give equal text
        let mut ks = self.keys()
        sort_strings(inout ks)
        w.begin_object()
        for k in ks {
            w.key(k.bytes())
            match self.get(k) {
                Some(v) => v.encode(inout w)
                None => w.null_value()
            }
        }
        w.end_object()
    }
}

fn sort_strings(inout xs: List[String]) {
    // insertion sort: objects are small
    for i in 1..xs.len() {
        let mut j = i.copy()
        while j > 0 && xs[j - 1] > xs[j] {
            let a = xs[j - 1].replace(String.from(""))
            let b = xs[j].replace(a)
            xs[j - 1] = b
            j -= 1
        }
    }
}

/// A record as an object: one member per field (`@json`: renamed, skipped, flattened).
pub fn encode_record[T](x: T, inout w: Writer) {
    w.begin_object()
    comptime for f in fields(T) {
        comptime if !attr[json](f).skip {
            comptime if attr[json](f).flatten {
                encode_flat(x.[f], inout w)
            } else {
                w.key(member_name(f.name, attr[json](f).name, attr[json](T).rename_all))
                x.[f].encode(inout w)
            }
        }
    }
    w.end_object()
}

fn encode_flat[F: Encode](x: F, inout w: Writer) {
    let mut inner = writer()
    x.encode(inout inner)
    w.members(inner.out)
}

/// An enum: a variant without fields as its name (`"Empty"`), one with fields as an object
/// with the discriminator first (`{"type": "Circle", "r": 2}`; `@json(tag = "kind")` on the
/// enum names it).
pub fn encode_enum[T](x: T, inout w: Writer) {
    comptime for v in variants(T) {
        if v.matches(x) {
            let name = member_name(v.name, attr[json](v).name, attr[json](T).rename_all)
            let mut n: u32 = 0
            comptime for f in fields(v) { n += 1 }
            if n == 0 {
                w.string(name)
            } else {
                w.begin_object()
                w.key(tag_key(attr[json](T).tag))
                w.string(name)
                comptime for f in fields(v) {
                    w.key(member_name(f.name, "", attr[json](T).rename_all))
                    x.[f].encode(inout w)
                }
                w.end_object()
            }
        }
    }
}

fn tag_key(t: str) -> List[u8] {
    if t.len() == 0 { return sys.lit("type") }
    t.bytes()
}

/// The key of a field or variant named `name`: `rename` if given, else `name` in the case
/// `rule` names.
pub fn member_name(name: str, rename: str, rule: str) -> List[u8] {
    if rename.len() > 0 { return rename.bytes() }
    let src = name.bytes()
    let r = rule.bytes()
    if r.len() == 0 { return src }
    // the words: split at `_` and before an upper-case letter after a lower-case one
    let mut words: List[List[u8]] = List.new()
    let mut cur: List[u8] = List.new()
    for i in 0..src.len() {
        let c = src[i]
        let is_up = c >= 65 && c <= 90
        let prev_lower = i > 0 && src[i - 1] >= 97 && src[i - 1] <= 122
        if c == 95 || (is_up && prev_lower) {
            if cur.len() > 0 { words.push(cur.replace(List.new())) }
            if c == 95 { continue }
        }
        cur.push(lower(c))
    }
    if cur.len() > 0 { words.push(cur) }
    let mut out: List[u8] = List.new()
    let camel = bytes.eq(r, sys.lit("camelCase"))
    let kebab = bytes.eq(r, sys.lit("kebab-case"))
    let scream = bytes.eq(r, sys.lit("SCREAMING_SNAKE_CASE"))
    for i in 0..words.len() {
        let wd = words[i].copy()
        if i > 0 && !camel { if kebab { out.push(45) } else { out.push(95) } }
        for j in 0..wd.len() {
            let c = wd[j]
            if (camel && i > 0 && j == 0) || scream { out.push(upper(c)) } else { out.push(c) }
        }
    }
    out
}

fn lower(c: u8) -> u8 {
    if c >= 65 && c <= 90 { return c + 32 }
    c
}

fn upper(c: u8) -> u8 {
    if c >= 97 && c <= 122 { return c - 32 }
    c
}

// ---- reading

/// Where decoding is: a parsed document, the node being read and the path to it; `claimed`
/// the members the record decoders took from the object at `node` (`flat` > 0 while a
/// flattened field reads that same object).
pub type Reader = { doc: Doc, node: u32, path: List[List[u8]], claimed: List[List[u8]], flat: u32 }

/// A reader of node `node` of a parsed document (path `$`): to decode part of a document
/// that was parsed already, `T.decode(inout json.reader(doc, id))`.
pub fn reader(doc: Doc, node: u32) -> Reader { Reader(doc, node, List.new(), List.new(), 0) }

impl Reader {
    /// The JSON kind (NULL ... OBJECT) of the value.
    fn kind(self) -> u32 { kind(self.doc, self.node) }

    /// The path as JSONPath: `$`, `.key` (`["key"]` for a key that isn't a name), `[i]`.
    fn where(self) -> List[u8] {
        let mut out = sys.lit("$")
        for s in self.path { bytes.append(inout out, s) }
        out
    }

    fn error(self, msg: List[u8]) -> DecodeError { DecodeError(self.where(), msg) }

    fn expected(self, what: str) -> DecodeError {
        let mut m = sys.lit("expected ")
        bytes.append(inout m, sys.lit(what))
        bytes.append(inout m, sys.lit(", found "))
        bytes.append(inout m, sys.lit(kind_name(self.kind())))
        self.error(m)
    }

    /// A reader of child node `id`, at path segment `seg`.
    fn child(self, id: u32, seg: List[u8]) -> Reader {
        let mut p = self.path.copy()
        p.push(seg)
        Reader(self.doc, id, p, List.new(), 0)
    }

    /// The integer value, if it is an integer in i64's range.
    fn int(self, what: str, lo: i64, hi: i64) -> Result[i64, DecodeError] {
        if self.kind() != NUMBER { return Err(self.expected(what)) }
        match as_int(self.doc, self.node) {
            Some(v) => {
                if v < lo || v > hi { return Err(self.error(range_msg(what))) }
                Ok(v)
            }
            None => Err(self.error(range_msg(what))),
        }
    }
}

fn range_msg(what: str) -> List[u8] {
    let mut m = sys.lit("not ")
    bytes.append(inout m, sys.lit(what))
    bytes.append(inout m, sys.lit(" (out of range, or not an integer)"))
    m
}

fn kind_name(k: u32) -> str {
    match k {
        1 => "null"
        2 => "a boolean"
        3 => "a number"
        4 => "a string"
        5 => "an array"
        6 => "an object"
        _ => "nothing"
    }
}

/// The path segment of member `key`.
fn key_seg(key: List[u8]) -> List[u8] {
    let mut plain = key.len() > 0
    for i in 0..key.len() {
        let c = key[i]
        let ok = c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (i > 0 && c >= 48 && c <= 57)
        if !ok { plain = false }
    }
    if plain {
        let mut s = sys.lit(".")
        bytes.append(inout s, key)
        return s
    }
    let mut s = sys.lit("[")
    quote_into(inout s, key)
    s.push(93)
    s
}

fn idx_seg(i: u32) -> List[u8] {
    let mut s = sys.lit("[")
    bytes.append(inout s, bytes.from_u64(i as u64))
    s.push(93)
    s
}

impl Decode for i64 {
    fn decode(inout r: Reader) -> Result[i64, DecodeError] { r.int("an i64", -9223372036854775807 - 1, 9223372036854775807) }
    fn missing() -> Option[i64] { None }
}

impl Decode for i32 {
    fn decode(inout r: Reader) -> Result[i32, DecodeError] {
        let v = r.int("an i32", -2147483648, 2147483647)?
        Ok(v as i32)
    }
    fn missing() -> Option[i32] { None }
}

impl Decode for u8 {
    fn decode(inout r: Reader) -> Result[u8, DecodeError] {
        let v = r.int("a u8", 0, 255)?
        Ok(v as u8)
    }
    fn missing() -> Option[u8] { None }
}

impl Decode for u32 {
    fn decode(inout r: Reader) -> Result[u32, DecodeError] {
        let v = r.int("a u32", 0, 4294967295)?
        Ok(v as u32)
    }
    fn missing() -> Option[u32] { None }
}

impl Decode for u64 {
    fn decode(inout r: Reader) -> Result[u64, DecodeError] { decode_u64(inout r, "a u64") }
    fn missing() -> Option[u64] { None }
}

impl Decode for usize {
    fn decode(inout r: Reader) -> Result[usize, DecodeError] {
        let v = decode_u64(inout r, "a usize")?
        Ok(v as usize)
    }
    fn missing() -> Option[usize] { None }
}

fn decode_u64(inout r: Reader, what: str) -> Result[u64, DecodeError] {
    if r.kind() != NUMBER { return Err(r.expected(what)) }
    let mut text: List[u8] = List.new()
    match num_text(r.doc, r.node) {
        Some(t) => { text = t }
        None => {}
    }
    match bytes.parse_u64(text) {
        Some(v) => Ok(v)
        None => Err(r.error(range_msg(what)))
    }
}

impl Decode for bool {
    fn decode(inout r: Reader) -> Result[bool, DecodeError] {
        match as_bool(r.doc, r.node) {
            Some(b) => Ok(b)
            None => Err(r.expected("a boolean"))
        }
    }
    fn missing() -> Option[bool] { None }
}

impl Decode for String {
    fn decode(inout r: Reader) -> Result[String, DecodeError] {
        let b = match as_str(r.doc, r.node) {
            Some(x) => x
            None => { return Err(r.expected("a string")) }
        }
        match String.from_bytes(b) {
            Ok(s) => Ok(s)
            Err(_) => Err(r.error(sys.lit("a string with a NUL character (\\u0000)")))
        }
    }
    fn missing() -> Option[String] { None }
}

impl[T: Decode] Decode for List[T] {
    fn decode(inout r: Reader) -> Result[List[T], DecodeError] {
        if r.kind() != ARRAY { return Err(r.expected("an array")) }
        let mut out: List[T] = List.new()
        for i in 0..len(r.doc, r.node) {
            let id: u32 = match at(r.doc, r.node, i) {
                Some(x) => x
                None => 0
            }
            let mut c = r.child(id, idx_seg(i))
            out.push(T.decode(inout c)?)
        }
        Ok(out)
    }
    fn missing() -> Option[List[T]] { None }
}

impl[T: Decode] Decode for Option[T] {
    fn decode(inout r: Reader) -> Result[Option[T], DecodeError] {
        if r.kind() == NULL { return Ok(None) }
        let v = T.decode(inout r)?
        Ok(Some(v))
    }
    fn missing() -> Option[Option[T]] { Some(None) }
}

impl[T: Decode] Decode for Map[String, T] {
    fn decode(inout r: Reader) -> Result[Map[String, T], DecodeError] {
        if r.kind() != OBJECT { return Err(r.expected("an object")) }
        let mut out: Map[String, T] = Map.new()
        for i in 0..len(r.doc, r.node) {
            let k = key_text(r.doc, r.node, i)
            let vid: u32 = match val_at(r.doc, r.node, i) {
                Some(x) => x
                None => 0
            }
            let mut c = r.child(vid, key_seg(k.copy()))
            let v = T.decode(inout c)?
            let ks = match String.from_bytes(k) {
                Ok(s) => s
                Err(_) => { return Err(c.error(sys.lit("a key with a NUL character"))) }
            }
            out.insert(ks, v)
        }
        Ok(out)
    }
    fn missing() -> Option[Map[String, T]] { None }
}

fn key_text(d: Doc, obj: u32, i: u32) -> List[u8] {
    match key_at(d, obj, i) {
        Some(k) => match as_str(d, k) {
            Some(s) => s
            None => List.new()
        }
        None => List.new()
    }
}

/// A record from an object: each field from its member (`@json`: renamed, skipped,
/// defaulted, flattened); a member no field takes is an error unless the record's
/// `@json(unknown = "ignore")` says otherwise.
pub fn decode_record[T](inout r: Reader) -> Result[T, DecodeError] {
    if r.kind() != OBJECT { return Err(r.expected("an object")) }
    let outer = r.flat == 0
    let saved = r.claimed.replace(List.new())
    let x = T(comptime for f in fields(T) {
        comptime if attr[json](f).skip {
            default_value()
        } else {
            comptime if attr[json](f).flatten {
                flat_value(inout r)?
            } else {
                comptime if attr[json](f).default {
                    member_or_default(inout r, member_name(f.name, attr[json](f).name, attr[json](T).rename_all))?
                } else {
                    member(inout r, member_name(f.name, attr[json](f).name, attr[json](T).rename_all))?
                }
            }
        }
    })
    if outer {
        check_unknown(r, attr[json](T).unknown)?
        r.claimed = saved
    } else {
        // a flattened record: its members are the outer record's to judge
        let mut all = saved.copy()
        for k in r.claimed { all.push(k) }
        r.claimed = all
    }
    Ok(x)
}

/// An enum from a string (a variant without fields) or an object whose discriminator member
/// (`type`, or the enum's `@json(tag = ...)`) names the variant.
pub fn decode_enum[T](inout r: Reader) -> Result[T, DecodeError] {
    let k = r.kind()
    let mut name: List[u8] = List.new()
    let tk = tag_key(attr[json](T).tag)
    if k == STRING {
        name = match as_str(r.doc, r.node) {
            Some(s) => s
            None => List.new()
        }
    } else if k == OBJECT {
        let tid = match get(r.doc, r.node, tk.copy()) {
            Some(x) => x
            None => {
                let mut m = sys.lit("missing the discriminator `")
                bytes.append(inout m, tk.copy())
                m.push(96)
                return Err(r.error(m))
            }
        }
        name = match as_str(r.doc, tid) {
            Some(s) => s
            None => { return Err(r.child(tid, key_seg(tk.copy())).expected("a string")) }
        }
    } else {
        return Err(r.expected("a string or an object"))
    }
    let saved = r.claimed.replace(List.new())
    r.claimed.push(tk.copy())
    comptime for v in variants(T) {
        if bytes.eq(name, member_name(v.name, attr[json](v).name, attr[json](T).rename_all)) {
            let x = v(comptime for f in fields(v) { member(inout r, member_name(f.name, "", attr[json](T).rename_all))? })
            if k == OBJECT { check_unknown(r, attr[json](T).unknown)? }
            r.claimed = saved
            return Ok(x)
        }
    }
    let mut m = sys.lit("unknown variant ")
    quote_into(inout m, name)
    Err(r.error(m))
}

fn default_value[F: Default]() -> F { F.default() }

/// Member `key` of the object `r` is at, decoded (claimed); absent: F.missing(), else an error.
fn member[F: Decode](inout r: Reader, key: List[u8]) -> Result[F, DecodeError] {
    if r.kind() != OBJECT { return Err(r.expected("an object")) }
    r.claimed.push(key.copy())
    match get(r.doc, r.node, key.copy()) {
        Some(id) => {
            let mut c = r.child(id, key_seg(key))
            F.decode(inout c)
        }
        None => {
            match F.missing() {
                Some(v) => Ok(v)
                None => {
                    let mut m = sys.lit("missing member ")
                    quote_into(inout m, key)
                    Err(r.error(m))
                }
            }
        }
    }
}

fn member_or_default[F: Decode + Default](inout r: Reader, key: List[u8]) -> Result[F, DecodeError] {
    if get(r.doc, r.node, key.copy()).is_none() {
        r.claimed.push(key)
        return Ok(F.default())
    }
    member(inout r, key)
}

/// A flattened field: its type decodes the same object.
fn flat_value[F: Decode](inout r: Reader) -> Result[F, DecodeError] {
    r.flat += 1
    let v = F.decode(inout r)
    r.flat -= 1
    v
}

fn check_unknown(r: Reader, policy: str) -> Result[bool, DecodeError] {
    if bytes.eq(policy.bytes(), sys.lit("ignore")) { return Ok(true) }
    for i in 0..len(r.doc, r.node) {
        let k = key_text(r.doc, r.node, i)
        if !r.claimed.contains(k) {
            let mut m = sys.lit("unknown member ")
            quote_into(inout m, k)
            return Err(r.error(m))
        }
    }
    Ok(true)
}
